---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image: string;
  favicon: string;
  keywords?: string;
}

const { title, description, image, favicon, keywords } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "SDL Domains",
  url: "https://sdl.life",
  email: "sales@desertrich.com",
  sameAs: ["https://sdl.life"]
};
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "sdl.life",
  url: "https://sdl.life",
  description,
  potentialAction: {
    "@type": "CommunicateAction",
    target: "mailto:sales@desertrich.com"
  }
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="robots" content="index,follow" />
    <meta name="google-site-verification" content="GBqnKtraaAgssIUJwKkCe68oWXYwQgnx5RIp3sPSn9I" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={favicon} type="image/png" />
    <link rel="apple-touch-icon" href={favicon} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="sdl.life" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={image} />
    <meta property="og:image:secure_url" content={image} />
    <meta property="og:image:alt" content="sdl.life premium domain acquisition" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100 antialiased">
    <slot />
  </body>
</html>
