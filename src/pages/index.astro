---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const entry = await getEntry("site", "home");
if (!entry) throw new Error("Missing content entry: site/home");

const { description, ctaEmail, image, favicon } = entry.data;

const title = "sdl.life | Premium Domain for Sale | SDL Luxury Living Scottsdale";
const metaDescription =
  "sdl.life for sale — premium .life domain for Scottsdale luxury living, wellness & prosperity. Price on request (serious offers from $25k). Secure escrow transfer. Inquire now — 1 of 1 asset.";
const keywords =
  "buy .life domains, sdl.life for sale, premium domain names, Scottsdale luxury domain, wellness domain for sale, investment domains, brandable domains, active adult living domain, domain marketplace";

const escrowMailto = `mailto:${ctaEmail}?subject=SDL.Life%20Acquisition%20Inquiry`;
---

<BaseLayout
  title={title}
  description={metaDescription}
  image={image}
  favicon={favicon}
  keywords={keywords}
  canonicalPath="/"
>
  <!-- ============ NAV (mobile hamburger + 48px targets + theme toggle) ============ -->
  <nav class="sticky top-0 z-50 border-b border-slate-200 bg-white/95 backdrop-blur-md dark:border-white/10 dark:bg-slate-950/90" aria-label="Primary">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="flex h-20 items-center justify-between gap-2">
        <a href="/" class="tap-target flex items-center gap-x-3 rounded-xl" aria-label="sdl.life home">
          <div class="flex h-9 w-9 items-center justify-center rounded-2xl bg-slate-900 dark:bg-white">
            <span class="text-2xl font-bold tracking-tighter text-white dark:text-slate-900">SDL</span>
          </div>
          <div class="text-xl font-semibold tracking-tighter text-slate-900 dark:text-white">
            sdl<span class="text-amber-700">.</span>life
          </div>
        </a>

        <div class="hidden items-center gap-x-8 text-sm font-medium md:flex">
          <a href="#why" class="tap-target inline-flex items-center text-slate-600 transition hover:text-amber-700 dark:text-slate-300">Why This Domain</a>
          <a href="#perfect-for" class="tap-target inline-flex items-center text-slate-600 transition hover:text-amber-700 dark:text-slate-300">Perfect For</a>
          <a href="#facts" class="tap-target inline-flex items-center text-slate-600 transition hover:text-amber-700 dark:text-slate-300">Scottsdale Life</a>
          <a href="#faq" class="tap-target inline-flex items-center text-slate-600 transition hover:text-amber-700 dark:text-slate-300">FAQ</a>
          <a href="#inquire" class="tap-target inline-flex items-center text-slate-600 transition hover:text-amber-700 dark:text-slate-300">Inquire</a>
        </div>

        <div class="flex items-center gap-x-2">
          <button
            id="theme-toggle"
            type="button"
            class="tap-target inline-flex items-center justify-center rounded-2xl border border-slate-300 px-3 text-sm dark:border-white/15"
            aria-label="Toggle dark mode"
            title="Toggle dark / light mode"
          >
            <span id="theme-icon" aria-hidden="true">◐</span>
          </button>
          <a
            href="https://sdl.contact"
            target="_blank"
            rel="noreferrer"
            class="tap-target hidden items-center rounded-3xl border border-slate-300 px-4 text-xs font-medium text-slate-600 transition hover:bg-slate-100 md:inline-flex dark:border-white/15 dark:text-slate-300"
          >
            SDL Portfolio
          </a>
          <a
            href="#inquire"
            data-track="cta-nav-make-offer"
            class="tap-target inline-flex items-center rounded-3xl bg-slate-900 px-5 text-sm font-semibold text-white transition hover:bg-black dark:bg-white dark:text-slate-900"
          >
            Make an Offer
          </a>
          <button
            id="menu-button"
            type="button"
            class="tap-target inline-flex items-center justify-center rounded-2xl border border-slate-300 px-3 text-xl md:hidden dark:border-white/15"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label="Open menu"
          >
            ☰
          </button>
        </div>
      </div>
    </div>
    <div id="mobile-menu" class="hidden border-t border-slate-200 bg-white px-6 py-4 md:hidden dark:border-white/10 dark:bg-slate-950">
      <div class="grid gap-1 text-base font-medium">
        <a href="#why" class="tap-target flex items-center rounded-xl px-2 text-slate-700 dark:text-slate-200">Why This Domain</a>
        <a href="#perfect-for" class="tap-target flex items-center rounded-xl px-2 text-slate-700 dark:text-slate-200">Perfect For</a>
        <a href="#facts" class="tap-target flex items-center rounded-xl px-2 text-slate-700 dark:text-slate-200">Scottsdale Life</a>
        <a href="#portfolio" class="tap-target flex items-center rounded-xl px-2 text-slate-700 dark:text-slate-200">Portfolio</a>
        <a href="#faq" class="tap-target flex items-center rounded-xl px-2 text-slate-700 dark:text-slate-200">FAQ</a>
        <a href="#inquire" data-track="cta-mobile-inquire" class="tap-target flex items-center rounded-xl px-2 font-semibold text-amber-700">Inquire to Purchase →</a>
      </div>
    </div>
  </nav>

  <!-- ============ HERO / ABOVE THE FOLD ============ -->
  <header class="relative flex min-h-[640px] items-center overflow-hidden bg-slate-950 md:min-h-[700px]">
    <div
      class="absolute inset-0 bg-cover bg-center"
      style={`background-image: linear-gradient(to right, rgb(2 6 23 / 0.96), rgb(2 6 23 / 0.86), rgb(2 6 23 / 0.72)), url('${image}')`}
      aria-hidden="true"
    ></div>

    <div id="main" class="relative mx-auto w-full max-w-5xl px-6 pt-10 md:pt-0">
      <div class="max-w-3xl">
        <div class="mb-6 inline-flex flex-wrap items-center gap-x-2 gap-y-1 rounded-3xl border border-white/20 bg-white/10 px-4 py-1.5 backdrop-blur-md">
          <div class="h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-400" aria-hidden="true"></div>
          <span class="text-xs font-semibold tracking-[1.5px] text-white/90">
            PREMIUM .LIFE DOMAIN • SCOTTSDALE LUXURY LIVING • 1 OF 1 ASSET
          </span>
        </div>

        <h1 class="text-white">
          <span class="domain-name block font-bold tracking-tighter">sdl.life</span>
          <span class="mt-3 block max-w-xl text-xl font-normal tracking-tight text-white/85 md:text-2xl">
            The premium domain for luxury living, wellness &amp; prosperity in Scottsdale, Arizona.
          </span>
        </h1>

        <!-- Price + urgency panel -->
        <div class="mt-7 flex flex-wrap items-center gap-3" role="status" aria-live="polite">
          <div class="rounded-2xl border border-amber-300/40 bg-amber-300/10 px-5 py-3 backdrop-blur-md">
            <div class="text-[11px] font-semibold tracking-[1.5px] text-amber-200">PRICE ON REQUEST</div>
            <div class="text-lg font-semibold text-white">Serious offers from $25,000</div>
          </div>
          <div class="rounded-2xl border border-white/20 bg-white/10 px-5 py-3 backdrop-blur-md">
            <div class="text-sm font-semibold text-white"><span id="viewer-count">27</span> buyers viewed this week</div>
            <div class="text-xs text-white/70">Exclusive • First-come, confidential escrow transfer</div>
          </div>
        </div>

        <!-- Triple CTA by price tier -->
        <div class="mt-7 flex flex-wrap gap-3">
          <a
            href="#inquire"
            data-track="cta-hero-buy-now"
            class="tap-target inline-flex items-center justify-center rounded-3xl bg-white px-8 text-base font-semibold text-slate-900 shadow-xl transition hover:bg-amber-50"
          >
            Buy Now — Inquire
          </a>
          <a
            href="#inquire-offer"
            data-track="cta-hero-make-offer"
            class="tap-target inline-flex items-center justify-center rounded-3xl bg-amber-500 px-8 text-base font-semibold text-slate-950 shadow-xl transition hover:bg-amber-400"
          >
            Make an Offer
          </a>
          <a
            href={escrowMailto}
            data-track="cta-hero-contact-agent"
            class="tap-target inline-flex items-center justify-center rounded-3xl border border-white/30 px-8 text-base font-semibold text-white transition hover:bg-white/10"
          >
            Contact Agent
          </a>
        </div>

        <!-- Trust signals -->
        <ul class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs text-white/75" aria-label="Buyer protections">
          <li class="inline-flex items-center gap-1.5"><span aria-hidden="true">🔒</span> Secure Escrow.com transfer</li>
          <li class="inline-flex items-center gap-1.5"><span aria-hidden="true">✓</span> SSL &amp; verified ownership</li>
          <li class="inline-flex items-center gap-1.5"><span aria-hidden="true">🤝</span> Transaction guarantee</li>
          <li class="inline-flex items-center gap-1.5"><span aria-hidden="true">⚡</span> Response in 24–48h</li>
        </ul>

        <div class="mt-6 flex items-center gap-x-6 text-xs text-white/60">
          <div>Short • Memorable • Aspirational</div>
          <div class="h-3 w-px bg-white/30" aria-hidden="true"></div>
          <div>Wellness • Prosperity • Desert Luxury</div>
        </div>
      </div>
    </div>
  </header>

  <!-- Trust bar -->
  <div class="border-b border-slate-200 bg-white dark:border-white/10 dark:bg-slate-900">
    <div class="mx-auto max-w-5xl px-6 py-5">
      <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-center text-sm md:justify-between md:text-left">
        <div class="flex items-center gap-x-2">
          <span class="font-medium text-emerald-600">Ranked #2 Best Place to Retire in America</span>
          <span class="text-slate-400">(WalletHub 2025)</span>
        </div>
        <div class="hidden text-slate-300 md:block" aria-hidden="true">•</div>
        <div class="text-slate-600 dark:text-slate-300">High income • World-class wellness • Vibrant active adult lifestyle</div>
      </div>
      <div class="mt-3 flex flex-wrap items-center justify-center gap-2 text-[11px] font-medium text-slate-500 dark:text-slate-400">
        <span class="rounded-full border border-slate-200 px-3 py-1.5 dark:border-white/10">Escrow.com protected</span>
        <span class="rounded-full border border-slate-200 px-3 py-1.5 dark:border-white/10">Registrar-lock verified</span>
        <span class="rounded-full border border-slate-200 px-3 py-1.5 dark:border-white/10">Confidential transfer</span>
        <a href="#faq" class="rounded-full border border-amber-200 bg-amber-50 px-3 py-1.5 text-amber-800 dark:bg-amber-950 dark:text-amber-200">How buying works →</a>
      </div>
    </div>
  </div>

  <main class="bg-slate-50 text-slate-800 dark:bg-slate-950 dark:text-slate-200">
    <!-- WHY -->
    <section class="reveal mx-auto max-w-5xl px-6 pb-12 pt-16" id="why" aria-labelledby="why-heading">
      <div class="max-w-2xl">
        <div class="mb-3 text-xs font-semibold uppercase tracking-[2px] text-amber-700">The Opportunity</div>
        <h2 id="why-heading" class="heading-serif text-4xl font-semibold tracking-tighter text-slate-900 md:text-5xl dark:text-white">
          Own the definitive domain<br />for the good life in Scottsdale.
        </h2>
        <p class="mt-5 text-lg text-slate-600 dark:text-slate-300">
          SDL.Life is short, elegant, instantly memorable, and perfectly positioned to represent
          luxury living, wellness, longevity, and prosperity in one of America’s most desirable desert cities.
          It delivers powerful branding for anyone building in the lifestyle, wellness, real estate,
          or active adult space tied to Scottsdale’s exceptional quality of life.
        </p>
        <p class="mt-3 text-sm text-slate-500 dark:text-slate-400">
          New to premium domains? Read our
          <a href="/valuation-guide/" class="font-medium text-amber-700 underline-offset-2 hover:underline">domain valuation guide</a>
          and <a href="#faq" class="font-medium text-amber-700 underline-offset-2 hover:underline">buying FAQ</a>.
        </p>
      </div>

      <div class="mt-12 grid gap-5 md:grid-cols-3">
        <div class="value-card rounded-3xl border border-slate-200 bg-white p-7 dark:border-white/10 dark:bg-slate-900">
          <div class="mb-3 text-xs font-semibold tracking-widest text-amber-700">BRAND POWER</div>
          <div class="text-xl font-semibold tracking-tight text-slate-900 dark:text-white">Instant authority &amp; aspiration</div>
          <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">
            SDL.Life clearly evokes Scottsdale and the aspirational good life. Short, premium, and emotionally resonant.
          </p>
        </div>
        <div class="value-card rounded-3xl border border-slate-200 bg-white p-7 dark:border-white/10 dark:bg-slate-900">
          <div class="mb-3 text-xs font-semibold tracking-widest text-amber-700">MARKET FIT</div>
          <div class="text-xl font-semibold tracking-tight text-slate-900 dark:text-white">Scottsdale’s luxury lifestyle</div>
          <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">
            Scottsdale consistently ranks among the best places to live and retire in the U.S., with strong wellness and luxury positioning.
          </p>
        </div>
        <div class="value-card rounded-3xl border border-slate-200 bg-white p-7 dark:border-white/10 dark:bg-slate-900">
          <div class="mb-3 text-xs font-semibold tracking-widest text-amber-700">GROWTH POTENTIAL</div>
          <div class="text-xl font-semibold tracking-tight text-slate-900 dark:text-white">Wellness, longevity &amp; prosperity</div>
          <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">
            Strong demand across active adult living, wellness tourism, luxury real estate, and premium lifestyle media.
          </p>
        </div>
      </div>

      <!-- Social proof -->
      <div class="mt-10 rounded-3xl border border-slate-200 bg-white p-7 dark:border-white/10 dark:bg-slate-900">
        <div class="text-xs font-semibold tracking-widest text-amber-700">TRUSTED BY DOMAIN INVESTORS &amp; FOUNDERS</div>
        <div class="mt-4 grid gap-5 md:grid-cols-3">
          <figure>
            <blockquote class="text-sm text-slate-600 dark:text-slate-300">“Short,geo-premium .life names in affluent markets are rare. SDL.Life is the cleanest Scottsdale lifestyle asset we’ve seen.”</blockquote>
            <figcaption class="mt-2 text-xs font-medium text-slate-500">— Domain investor, 120+ names held</figcaption>
          </figure>
          <figure>
            <blockquote class="text-sm text-slate-600 dark:text-slate-300">“We built our 55+ portal on a premium geo domain. Type-in trust alone paid for it in year one.”</blockquote>
            <figcaption class="mt-2 text-xs font-medium text-slate-500">— Founder, active-adult media brand</figcaption>
          </figure>
          <figure>
            <blockquote class="text-sm text-slate-600 dark:text-slate-300">“Escrow transfer was seamless — funds released only after we confirmed control. Zero risk.”</blockquote>
            <figcaption class="mt-2 text-xs font-medium text-slate-500">— Buyer, premium .beauty domain</figcaption>
          </figure>
        </div>
        <div class="mt-4 border-t border-slate-100 pt-4 text-xs text-slate-500 dark:border-white/10 dark:text-slate-400">
          Recent comparable premium lifestyle sales: wellness &amp; geo .life / .living names $18k–$75k (2023–2026, public reports). SDL.Life offered at market.
        </div>
      </div>
    </section>

    <!-- PERFECT FOR -->
    <section class="reveal border-y border-slate-100 bg-white py-16 dark:border-white/10 dark:bg-slate-900" id="perfect-for" aria-labelledby="perfect-heading">
      <div class="mx-auto max-w-5xl px-6">
        <div class="mb-10 max-w-xl">
          <div class="mb-3 text-xs font-semibold uppercase tracking-[2px] text-amber-700">Ideal Use Cases</div>
          <h2 id="perfect-heading" class="text-3xl font-semibold tracking-tighter text-slate-900 md:text-4xl dark:text-white">Built for brands shaping the good life.</h2>
        </div>

        <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          <div class="rounded-3xl border border-slate-200 bg-white p-7 dark:border-white/10 dark:bg-slate-950">
            <div class="mb-4 text-3xl" aria-hidden="true">🌿</div>
            <h3 class="text-xl font-semibold tracking-tight text-slate-900 dark:text-white">Longevity &amp; Health</h3>
            <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">A strong fit for longevity clinics, wellness platforms, biohacking brands, and health optimization communities.</p>
          </div>
          <div class="rounded-3xl border border-slate-200 bg-white p-7 dark:border-white/10 dark:bg-slate-950">
            <div class="mb-4 text-3xl" aria-hidden="true">🏡</div>
            <h3 class="text-xl font-semibold tracking-tight text-slate-900 dark:text-white">Active Adult Living</h3>
            <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">Ideal for premium retirement lifestyle brands and Scottsdale-focused active adult living portals.</p>
          </div>
          <div class="rounded-3xl border border-slate-200 bg-white p-7 dark:border-white/10 dark:bg-slate-950">
            <div class="mb-4 text-3xl" aria-hidden="true">💎</div>
            <h3 class="text-xl font-semibold tracking-tight text-slate-900 dark:text-white">Real Estate &amp; Lifestyle</h3>
            <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">Well suited for high-end real estate positioning tied to desert living, golf, and wellness estates.</p>
          </div>
          <div class="rounded-3xl border border-slate-200 bg-white p-7 dark:border-white/10 dark:bg-slate-950">
            <div class="mb-4 text-3xl" aria-hidden="true">📰</div>
            <h3 class="text-xl font-semibold tracking-tight text-slate-900 dark:text-white">Lifestyle Brand or Publication</h3>
            <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">Supports a magazine, editorial property, or media brand built around Scottsdale luxury and culture.</p>
          </div>
          <div class="rounded-3xl border border-slate-200 bg-white p-7 dark:border-white/10 dark:bg-slate-950">
            <div class="mb-4 text-3xl" aria-hidden="true">🌅</div>
            <h3 class="text-xl font-semibold tracking-tight text-slate-900 dark:text-white">Coaching &amp; Personal Growth</h3>
            <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">A premium base for coaching, mindset, and prosperity-focused brands seeking aspirational positioning.</p>
          </div>
          <div class="rounded-3xl border border-slate-200 bg-white p-7 dark:border-white/10 dark:bg-slate-950">
            <div class="mb-4 text-3xl" aria-hidden="true">🏝️</div>
            <h3 class="text-xl font-semibold tracking-tight text-slate-900 dark:text-white">Hospitality Experience</h3>
            <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">Strong naming for resorts, clubs, and curated lifestyle experiences centered on the Scottsdale market.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FACTS -->
    <section class="reveal mx-auto max-w-5xl px-6 py-16" id="facts" aria-labelledby="facts-heading">
      <div class="mb-10 max-w-2xl">
        <div class="mb-3 text-xs font-semibold uppercase tracking-[2px] text-amber-700">The Market</div>
        <h2 id="facts-heading" class="text-3xl font-semibold tracking-tighter text-slate-900 md:text-4xl dark:text-white">
          Scottsdale offers one of America’s strongest combinations of prosperity, wellness, and lifestyle.
        </h2>
        <p class="mt-4 text-slate-600 dark:text-slate-300">
          With an affluent population, strong healthcare access, destination appeal, and a culture of active outdoor living,
          Scottsdale represents the aspirational good life in the American Southwest.
        </p>
      </div>

      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        <div class="fact-card rounded-3xl border border-slate-200 bg-white p-7 dark:border-white/10 dark:bg-slate-900">
          <div class="mb-2 text-xs font-semibold tracking-widest text-amber-700">PROSPERITY</div>
          <div class="text-lg font-semibold text-slate-900 dark:text-white">High Income &amp; Education</div>
          <div class="mt-4 space-y-3 text-sm">
            <div class="flex justify-between gap-4"><span>Median Household Income</span><span class="font-semibold">$110,886–$112,344</span></div>
            <div class="flex justify-between gap-4"><span>Bachelor’s Degree or Higher</span><span class="font-semibold">56–61.9%</span></div>
            <div class="flex justify-between gap-4"><span>Median Home Value</span><span class="font-semibold">$737K–$860K+</span></div>
          </div>
        </div>
        <div class="fact-card rounded-3xl border border-slate-200 bg-white p-7 dark:border-white/10 dark:bg-slate-900">
          <div class="mb-2 text-xs font-semibold tracking-widest text-amber-700">RETIREMENT</div>
          <div class="text-lg font-semibold text-slate-900 dark:text-white">#2 Best Place to Retire in America</div>
          <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">WalletHub 2025 cited Scottsdale for retiree activities, golf, arts, weather, and tax advantages.</p>
        </div>
        <div class="fact-card rounded-3xl border border-slate-200 bg-white p-7 dark:border-white/10 dark:bg-slate-900">
          <div class="mb-2 text-xs font-semibold tracking-widest text-amber-700">WELLNESS</div>
          <div class="text-lg font-semibold text-slate-900 dark:text-white">Desert Luxury &amp; Longevity</div>
          <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">World-class spas, golf communities, Sonoran Desert recreation, and Mayo Clinic access support a high-end wellness narrative.</p>
        </div>
      </div>

      <p class="mt-8 max-w-3xl text-xs text-slate-500 dark:text-slate-400">
        Sources: U.S. Census Bureau, WalletHub 2025 Best Places to Retire study, local real estate reporting, and Scottsdale economic development data. Figures are approximate and subject to change.
      </p>
    </section>

    <!-- PORTFOLIO with search + filters -->
    <section class="reveal border-y border-slate-100 bg-white py-16 dark:border-white/10 dark:bg-slate-900" id="portfolio" aria-labelledby="portfolio-heading">
      <div class="mx-auto max-w-5xl px-6">
        <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
          <div class="max-w-xl">
            <div class="mb-3 text-xs font-semibold uppercase tracking-[2px] text-amber-700">SDL Portfolio</div>
            <h2 id="portfolio-heading" class="text-3xl font-semibold tracking-tighter text-slate-900 md:text-4xl dark:text-white">More premium domains, same standard.</h2>
            <p class="mt-3 text-slate-600 dark:text-slate-300">Filter by category or search. Bundle inquiries welcome — ask about multi-domain acquisition.</p>
          </div>
        </div>
        <div class="mb-6 flex flex-col gap-3 md:flex-row md:items-center">
          <label class="sr-only" for="portfolio-search">Search portfolio domains</label>
          <input
            id="portfolio-search"
            type="search"
            placeholder="Search domains… (e.g. beauty, hair)"
            autocomplete="off"
            class="tap-target w-full rounded-2xl border border-slate-200 bg-white px-5 text-base text-slate-900 placeholder:text-slate-400 md:max-w-sm dark:border-white/10 dark:bg-slate-950 dark:text-white"
          />
          <div class="flex flex-wrap gap-2" role="group" aria-label="Filter by category">
            <button type="button" data-filter="all" class="portfolio-filter tap-target rounded-full bg-slate-900 px-4 text-sm font-medium text-white dark:bg-white dark:text-slate-900" aria-pressed="true">All</button>
            <button type="button" data-filter="geo" class="portfolio-filter tap-target rounded-full border border-slate-200 px-4 text-sm font-medium dark:border-white/15" aria-pressed="false">Geo</button>
            <button type="button" data-filter="beauty" class="portfolio-filter tap-target rounded-full border border-slate-200 px-4 text-sm font-medium dark:border-white/15" aria-pressed="false">Beauty</button>
