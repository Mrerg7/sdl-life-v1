---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const entry = await getEntry("site", "home");
if (!entry) throw new Error("Missing content entry: site/home");

const { title, subtitle, description, ctaEmail, image } = entry.data;
---

<BaseLayout title={title} description={description} image={image}>
  <main class="mx-auto flex min-h-screen max-w-6xl flex-col px-6 py-12 md:px-10">
    <header class="mb-16">
      <p class="mb-4 inline-flex rounded-full border border-cyan-400/40 bg-cyan-500/10 px-4 py-1 text-xs font-semibold uppercase tracking-widest text-cyan-200">
        Cloudflare Global Edge
      </p>
      <h1 class="text-balance text-5xl font-semibold tracking-tight text-white sm:text-6xl md:text-7xl">
        {title}
      </h1>
      <p class="mt-4 max-w-3xl text-lg text-slate-300">{subtitle}</p>
      <p class="mt-4 max-w-3xl text-slate-400">{description}</p>
    </header>

    <section class="grid gap-8 rounded-3xl border border-slate-800 bg-slate-900/50 p-6 md:grid-cols-[1.1fr_1fr] md:p-8">
      <img
        src={image}
        alt="sdl.life representative visual delivered by Cloudflare Images"
        loading="eager"
        fetchpriority="high"
        class="h-full max-h-[420px] w-full rounded-2xl border border-slate-700 object-cover"
      />
      <div class="flex flex-col justify-between">
        <div>
          <h2 class="text-2xl font-semibold text-white md:text-3xl">Acquire a high-signal digital asset.</h2>
          <p class="mt-4 text-slate-300">
            Built as an Astro static site for Workers Static Assets, this page is globally distributed, fast to cache, and ready for immediate domain-buyer outreach.
          </p>
          <ul class="mt-6 space-y-2 text-sm text-slate-300">
            <li>Static output for maximum cacheability and minimal runtime risk.</li>
            <li>Cloudflare Images CDN URL integrated for hero and social sharing.</li>
            <li>Structured data, OG, Twitter, sitemap, and robots configured.</li>
          </ul>
        </div>
        <a
          href={`mailto:${ctaEmail}?subject=SDL.Life%20Acquisition%20Inquiry`}
          class="mt-8 inline-flex w-fit items-center justify-center rounded-full bg-cyan-400 px-7 py-3 text-sm font-semibold uppercase tracking-wide text-slate-950 transition hover:bg-cyan-300"
        >
          Inquire for Acquisition
        </a>
      </div>
    </section>
  </main>

  <footer class="border-t border-slate-800 bg-slate-950/95">
    <div class="mx-auto grid max-w-6xl gap-8 px-6 py-10 md:grid-cols-[1.15fr_1fr] md:px-10">
      <div>
        <h3 class="text-xl font-semibold text-white">Domain Available for Acquisition</h3>
        <p class="mt-3 max-w-2xl text-sm leading-6 text-slate-300">
          Strategic buyers, portfolio operators, and category leaders can route direct acquisition interest to
          <a class="font-medium text-cyan-300 hover:text-cyan-200" href={`mailto:${ctaEmail}`}> {ctaEmail}</a>.
          Engagements are handled privately and evaluated on buyer fit, execution capability, and long-term brand intent.
        </p>
      </div>
      <div class="rounded-2xl border border-slate-800 bg-slate-900/60 p-4 text-xs leading-5 text-slate-400">
        This website is for demonstration and informational purposes only. It does not constitute an offer of services, a commitment to deploy, or a guarantee of outcomes. All statistics, projections, and references to specific technologies are based on publicly available information as of the date shown and are subject to change.
      </div>
    </div>
  </footer>
</BaseLayout>
